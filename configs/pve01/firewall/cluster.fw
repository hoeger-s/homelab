[OPTIONS]

enable: 1

[ALIASES]

admin 10.0.10.50 # Admin-Geräte
cal01 10.0.40.30 # Radicale
ki01 10.0.40.50 # KI-Assistent (CT 110)
mon01 10.0.40.90 # Monitoring
proxy01 10.0.40.10 # Reverse Proxy
pve01 10.0.99.10 # Proxmox-Host
trusted 10.0.10.0/24 # Trusted-VLAN
vpn 192.168.2.0/24 # WireGuard

[RULES]

IN ACCEPT -source dc/admin -p tcp -dport 22 -log nolog # SSH von admin (Workstation)
IN ACCEPT -source dc/admin -p tcp -dport 8006 -log nolog # Weboberfläche von admin (Workstation)
IN ACCEPT -source dc/mon01 -p tcp -dport 22 -log nolog # SSH von mon01 (Host-Sicherung, eingeschränkter Schlüssel)
IN ACCEPT -source dc/mon01 -p tcp -dport 8006 -log nolog # API von mon01 (PVE-Exporter)
IN ACCEPT -source dc/mon01 -p tcp -dport 9100 -log nolog # Node-Exporter von mon01
IN ACCEPT -source dc/mon01 -p tcp -dport 9835 -log nolog # GPU-Exporter von mon01
