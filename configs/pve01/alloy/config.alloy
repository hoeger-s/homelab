loki.relabel "journal_pve01" {
  forward_to = []

  rule {
    target_label = "job"
    replacement  = "systemd-journal"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "pve01" {
  max_age       = "12h"
  labels        = {
    host = "pve01",
  }
  relabel_rules = loki.relabel.journal_pve01.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://10.0.40.90:3100/loki/api/v1/push"
  }
}
